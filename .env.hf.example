# ─────────────────────────────────────────────────────────────────────────────
# ReachInbox – Hugging Face Spaces Environment Variables
# Set all of these as "Repository Secrets" in your HF Space settings.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5001

# ── Database (get from https://neon.tech – free PostgreSQL) ──────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/reachinbox?sslmode=require

# ── Redis (get from https://upstash.com – free Redis) ────────────────────────
REDIS_URL=rediss://default:your_upstash_password@your-redis.upstash.io:6379

# ── JWT & Encryption ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
ENCRYPTION_KEY=your_32_char_encryption_key_here_!!

# ── System SMTP (Gmail app password for fallback sending) ────────────────────
SYSTEM_SMTP_HOST=smtp.gmail.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=your_gmail@gmail.com
SYSTEM_SMTP_PASSWORD=your_google_app_password_here

# ── Google OAuth2 (for "Sign in with Google" feature) ────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# !! IMPORTANT: Replace YOUR_HF_USERNAME and YOUR_SPACE_NAME with actual values
GOOGLE_CALLBACK_URL=https://YOUR_HF_USERNAME-YOUR_SPACE_NAME.hf.space/api/auth/google/callback
FRONTEND_URL=https://YOUR_HF_USERNAME-YOUR_SPACE_NAME.hf.space

# ── Email rate limits ────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
MAX_EMAILS_PER_HOUR=100
MIN_DELAY_BETWEEN_EMAILS_MS=3000
